command-move =
    .base =
        MOVE  حدد نقطة الأساس  [{ $count ->
            [zero] لا توجد كائنات
            [one] كائن واحد
            [two] كائنان
            [few] { $count } كائنات
            [many] { $count } كائنًا
           *[other] { $count } كائن
        }]:
    .target = MOVE  حدد الوجهة  [الأساس { $x },{ $y }]:

command-copy =
    .array-count = COPY  أدخل عدد عناصر المصفوفة:
    .base =
        COPY  حدد نقطة الأساس  [{ $count ->
            [zero] لا توجد كائنات
            [one] كائن واحد
            [two] كائنان
            [few] { $count } كائنات
            [many] { $count } كائنًا
           *[other] { $count } كائن
        }]:
    .array-target = COPY  حدد النقطة الثانية للمصفوفة ذات { $count } عنصر  [الأساس { $x },{ $y }]:
    .target =
        COPY  حدد الوجهة  [{ $count ->
            [zero] لا توجد نسخ حتى الآن
            [one] نسخة واحدة حتى الآن
            [two] نسختان حتى الآن
            [few] { $count } نسخ حتى الآن
            [many] { $count } نسخة حتى الآن
           *[other] { $count } نسخة حتى الآن
        } | مصفوفة | Enter=إنهاء | الأساس { $x },{ $y }]:

