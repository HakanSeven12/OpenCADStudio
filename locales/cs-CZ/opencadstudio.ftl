mtext-source-errors = MTEXT
    .nesting = MTEXT: tato úprava by překročila bezpečný limit vnoření formátovacích skupin.
    .raw-field = MTEXT: text obsahuje chráněný výraz pole.
    .unknown = MTEXT: neznámý, neúplný nebo neplatný řídicí kód brání bezpečné úpravě textu.
    .range = MTEXT: rozsah znaků nemá ve zdrojovém textu bezpečné hranice.
    .atomic = MTEXT: tato operace by rozdělila nebo změnila chráněný zlomek nebo zalomení sloupce.
    .paragraph = MTEXT: tato změna by mohla ovlivnit nastavení odstavce nebo zarážek tabulátoru.
    .input = MTEXT: vložený text obsahuje nepodporovaný řídicí znak.
    .projection = MTEXT: pozice znaků ve zdrojovém a vykresleném textu si neodpovídají; úprava nebyla provedena.
    .object-default = MTEXT: výchozí formát objektu nelze bezpečně oddělit od příznaků znaků nebo chráněných řídicích kódů.
    .field-text = MTEXT: text pole nelze změnit ani rozdělit; upravte text kolem něj.
    .native-field = MTEXT: úprava textu je u nativního hostitele FIELD zakázána; šablona pole musí zůstat zachována.
    .stack-text = MTEXT: index nebo zlomek smí obsahovat jen prosté znaky: žádné zalomení řádku, zlomek, zpětné lomítko, složenou závorku ani znaky / # ^ % ;.
    .stack-format = MTEXT: index nebo zlomek může mít jen jedno formátování; výběr obsahuje různé formáty.
    .fraction-parts = MTEXT: zlomek vyžaduje čitatele i jmenovatele.
    .rotation-unsupported = MTEXT: natočení není pro tuto rovinu textu nebo cíl editoru ověřeno; stav zůstal beze změny.

