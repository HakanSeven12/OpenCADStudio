gpu =
    .title = Cảnh báo đồ họa
    .software-headline = Không tìm thấy trình điều khiển GPU hoạt động, vì vậy bản vẽ được hiển thị bằng phần mềm trên CPU ({ $adapter }).
    .software-consequences = Các bản vẽ lớn sẽ di chuyển chậm, và việc hiển thị có thể không đầy đủ hoặc không ổn định.
    .no-renderer-headline = Không có bộ kết xuất GPU nào khả dụng trên hệ thống này, vì vậy khu vực bản vẽ không thể hiển thị. Phần còn lại của giao diện vẫn hoạt động.
    .hint-linux = Kiểm tra trình điều khiển đồ họa — cập nhật trình điều khiển mà chưa khởi động lại là nguyên nhân thông thường.
    .hint-windows = Cập nhật hoặc cài đặt lại trình điều khiển đồ họa. Phiên làm việc Remote Desktop và máy ảo có thể không cung cấp tăng tốc GPU.
    .hint-macos = Mac này không cung cấp GPU khả dụng cho ứng dụng; máy ảo thường không làm được điều đó.
    .hint-web = Bật tăng tốc phần cứng trong cài đặt trình duyệt hoặc cập nhật trình điều khiển đồ họa, sau đó tải lại trang.
    .pill-software = ⚠ Kết xuất phần mềm
    .pill-no-renderer = ⚠ Không có bộ kết xuất GPU
    .pill-tip = Nhấp để xem chi tiết
    .silence = Không hiển thị lại cho thiết bị này
    .command-line-no-renderer = Không có bộ kết xuất GPU nào khả dụng — khu vực bản vẽ không thể hiển thị. Kiểm tra trình điều khiển đồ họa.

