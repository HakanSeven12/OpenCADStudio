{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenCAD Studio Automation API",
    "version": "1",
    "description": "REST surface over the OpenCAD Studio automation dispatcher. The server runs headless via `OpenCADStudio --http <port>`, binds 127.0.0.1 only, and keeps one drawing session alive across requests. All bodies are JSON; failure bodies carry a symbolic `code` (see the automation README for the catalogue)."
  },
  "servers": [{"url": "http://127.0.0.1:8090"}],
  "security": [{"bearer": []}],
  "paths": {
    "/api/v1/ready": {
      "get": {
        "summary": "Server readiness, version and active document id",
        "responses": {"200": {"description": "Ready"}}
      }
    },
    "/api/v1/state": {
      "get": {
        "summary": "Full editor state: session, documents, selection, command, camera",
        "responses": {"200": {"description": "State"}}
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "summary": "Feature and collection advertisement",
        "responses": {"200": {"description": "Capabilities"}}
      }
    },
    "/api/v1/documents": {
      "get": {"summary": "Open documents", "responses": {"200": {"description": "Documents"}}},
      "post": {
        "summary": "Open a drawing ({path}), start from a template ({template}, .dwt/.dwg/.dxf), or create a fresh untitled document in its own tab (empty body)",
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "properties": {"path": {"type": "string"}, "template": {"type": "string"}}}}}},
        "responses": {"200": {"description": "Document ready"}, "201": {"description": "Fresh document created"}, "400": {"description": "Open failed"}}
      }
    },
    "/api/v1/documents/{id}": {
      "delete": {
        "summary": "Close a document; a dirty document needs ?discard=true",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {"200": {"description": "Closed"}, "400": {"description": "Dirty document without discard"}}
      }
    },
    "/api/v1/sysvars": {
      "get": {
        "summary": "Read sysvars (?names=csv; empty list returns every readable name)",
        "parameters": [{"name": "names", "in": "query", "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Values"}}
      },
      "post": {
        "summary": "Set sysvars atomically ({set:{name:value,…}}; unknown_sysvar / invalid_sysvar_value refused)",
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "properties": {"set": {"type": "object"}, "get": {"type": "array", "items": {"type": "string"}}}}}}},
        "responses": {"200": {"description": "Applied"}, "400": {"description": "Unknown sysvar or invalid value"}}
      }
    },
    "/api/v1/xrefs": {
      "get": {
        "summary": "Fresh structured external-reference listing (direct and nested rows; embedded images omitted)",
        "responses": {"200": {"description": "{count,xrefs[]}; rows contain id, name, kind, format, reference_type, status, saved_path, resolved_path, parent_id, nested, size_bytes, modified_unix_ms", "content": {"application/json": {"schema": {"type": "object", "properties": {"count": {"type": "integer"}, "xrefs": {"type": "array", "items": {"$ref": "#/components/schemas/ExternalReference"}}}}}}}}
      }
    },
    "/api/v1/xref_reload": {
      "post": {
        "summary": "Reload one direct DWG/DXF xref, underlay, or point cloud; prior content survives load failure",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/XrefIdRequest"}}}},
        "responses": {"200": {"description": "Fresh reference and diagnostics"}, "400": {"description": "Unsupported kind or load failure"}, "404": {"description": "Unknown reference"}}
      }
    },
    "/api/v1/xref_unload": {
      "post": {
        "summary": "Unload one direct reference without deleting its definition",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/XrefIdRequest"}}}},
        "responses": {"200": {"description": "Fresh reference, session_only, unchanged"}, "404": {"description": "Unknown reference"}}
      }
    },
    "/api/v1/xref_detach": {
      "post": {
        "summary": "Detach one direct reference, its insertion, and owned dependent records in one undo step",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/XrefIdRequest"}}}},
        "responses": {"200": {"description": "Detached id and name"}, "404": {"description": "Unknown reference"}}
      }
    },
    "/api/v1/xref_bind": {
      "post": {
        "summary": "Bind one direct DWG/DXF xref into a local block definition",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/XrefIdRequest"}}}},
        "responses": {"200": {"description": "Local block and unremapped count"}, "400": {"description": "Unsupported kind or bind failure"}, "404": {"description": "Unknown reference"}}
      }
    },
    "/api/v1/xref_set_path": {
      "post": {
        "summary": "Set one direct reference's stored path or path type without reloading",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/XrefSetPathRequest"}}}},
        "responses": {"200": {"description": "old_path, saved_path, reload_required, unchanged, reference"}, "400": {"description": "Invalid or unconvertible path"}, "404": {"description": "Unknown reference"}}
      }
    },
    "/api/v1/xref_set_type": {
      "post": {
        "summary": "Switch one direct DWG/DXF xref between attachment and overlay",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/XrefSetTypeRequest"}}}},
        "responses": {"200": {"description": "Fresh reference and unchanged"}, "400": {"description": "Unsupported kind or invalid reference type"}, "404": {"description": "Unknown reference"}}
      }
    },
    "/api/v1/layouts": {
      "get": {
        "summary": "List layouts",
        "responses": {"200": {"description": "Layouts"}}
      },
      "post": {
        "summary": "Create a layout with the default page setup",
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}}}}}},
        "responses": {"201": {"description": "Layout created"}, "400": {"description": "Duplicate or invalid name"}}
      }
    },
    "/api/v1/layouts/{name}": {
      "patch": {
        "summary": "Rename a layout",
        "parameters": [{"name": "name", "in": "path", "required": true, "schema": {"type": "string"}}],
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "required": ["new_name"], "properties": {"new_name": {"type": "string"}}}}}},
        "responses": {"200": {"description": "Layout renamed"}, "400": {"description": "Duplicate or invalid new name"}, "404": {"description": "Unknown layout"}}
      },
      "delete": {
        "summary": "Delete a layout",
        "parameters": [{"name": "name", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Layout deleted"}, "400": {"description": "Deletion refused"}, "404": {"description": "Unknown layout"}}
      }
    },
    "/api/v1/layouts/{name}/activate": {
      "post": {
        "summary": "Activate a layout",
        "parameters": [{"name": "name", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Layout activated"}, "404": {"description": "Unknown layout"}}
      }
    },
    "/api/v1/layouts/{name}/page-setup": {
      "get": {
        "summary": "Read a layout's plot configuration",
        "parameters": [{"name": "name", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Stored setup"}, "404": {"description": "Unknown layout"}}
      },
      "put": {
        "summary": "Write a layout's plot configuration (explicit fields win)",
        "parameters": [{"name": "name", "in": "path", "required": true, "schema": {"type": "string"}}],
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "properties": {
          "paper": {"type": "string"}, "orientation": {"type": "string", "enum": ["portrait", "landscape"]},
          "fit": {"type": "boolean"}, "scale": {"type": "string"}, "center": {"type": "boolean"},
          "offset_x": {"type": "number"}, "offset_y": {"type": "number"},
          "area": {"type": "string", "enum": ["extents", "display", "limits", "layout", "window"]},
          "window": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}, "plot_style": {"type": "string"}
        }}}}},
        "responses": {"200": {"description": "Stored setup"}, "400": {"description": "Invalid paper or scale"}, "404": {"description": "Unknown layout"}}
      }
    },
    "/api/v1/entities": {
      "get": {
        "summary": "Query entities (type, layer, detail, offset, limit, fields, handles, bounds, near, contains_point, intersections)",
        "parameters": [
          {"name": "type", "in": "query", "schema": {"type": "string"}},
          {"name": "layer", "in": "query", "description": "* and ? are wildcards", "schema": {"type": "string"}},
          {"name": "xdata_app", "in": "query", "description": "Only entities carrying XDATA of this application", "schema": {"type": "string"}},
          {"name": "detail", "in": "query", "schema": {"type": "string", "enum": ["summary", "geometry", "full"]}},
          {"name": "offset", "in": "query", "schema": {"type": "integer"}},
          {"name": "limit", "in": "query", "schema": {"type": "integer"}},
          {"name": "fields", "in": "query", "schema": {"type": "string"}, "description": "Comma-separated projection"},
          {"name": "bounds", "in": "query", "schema": {"type": "string"}, "description": "min_x,min_y,max_x,max_y"},
          {"name": "near", "in": "query", "schema": {"type": "string"}, "description": "x,y[,z] distance ranking"},
          {"name": "contains_point", "in": "query", "schema": {"type": "string"}},
          {"name": "intersections", "in": "query", "schema": {"type": "string"}, "description": "handle1,handle2"},
          {"name": "where", "in": "query", "schema": {"type": "string"}, "description": "JSON-encoded filter array over serialized properties, e.g. [{\"path\":\"/radius\",\"op\":\"gt\",\"value\":2}] with ops eq,ne,lt,lte,gt,gte,contains,starts_with,ends_with,in,exists,not_exists"}
        ],
        "responses": {"200": {"description": "Matched entities"}, "400": {"description": "Invalid filters"}}
      },
      "post": {
        "summary": "Create a batch of typed entities (Line, Circle, Arc, LwPolyline, Point, Text, MText, Insert, Solid, Hatch); missing layers are created; one undo step",
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "required": ["entities"], "properties": {"entities": {"type": "array", "items": {"type": "object"}}}}}}},
        "responses": {"201": {"description": "Handles of the created entities"}, "400": {"description": "Invalid definitions; nothing committed"}}
      },
      "delete": {
        "summary": "Erase entities by handle (?handles=a,b or body {handles})",
        "responses": {"200": {"description": "Erased"}, "404": {"description": "Unknown handle; nothing erased"}}
      }
    },
    "/api/v1/entities/{handle}": {
      "get": {
        "summary": "One entity with full detail",
        "parameters": [{"name": "handle", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Entity"}, "404": {"description": "Unknown handle"}}
      }
    },
    "/api/v1/entities/transform": {
      "post": {
        "summary": "Move/copy/rotate/scale/mirror/array entities (angles in degrees)",
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "required": ["handles", "action"], "properties": {
          "handles": {"type": "array", "items": {"type": "string"}},
          "action": {"type": "string", "enum": ["move", "copy", "rotate", "scale", "mirror", "array"]},
          "vector": {"type": "array", "items": {"type": "number"}},
          "center": {"type": "array", "items": {"type": "number"}},
          "angle_deg": {"type": "number"},
          "factor": {"type": "number"},
          "axis": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
          "copy": {"type": "boolean"},
          "rows": {"type": "integer"}, "columns": {"type": "integer"},
          "row_spacing": {"type": "number"}, "column_spacing": {"type": "number"}
        }}}}},
        "responses": {"200": {"description": "Transformed; `created` lists new handles"}, "400": {"description": "Invalid action or parameters"}}
      }
    },
    "/api/v1/entities/copy-to": {
      "post": {
        "summary": "Copy entities into another open document (referenced layer definitions travel along)",
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "required": ["handles", "document_id"], "properties": {
          "handles": {"type": "array", "items": {"type": "string"}},
          "document_id": {"type": "integer", "description": "Target document"}
        }}}}},
        "responses": {"201": {"description": "New handles in the target document"}, "404": {"description": "Unknown handle"}, "400": {"description": "Target absent"}}
      }
    },
    "/api/v1/entities/{handle}/xdata": {
      "get": {
        "summary": "Read extended data (?app= filters one application)",
        "parameters": [
          {"name": "handle", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "app", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Per-application records"}, "404": {"description": "Unknown handle"}}
      }
    },
    "/api/v1/entities/{handle}/xdata/{app}": {
      "put": {
        "summary": "Replace one application's extended data (typed [{code,value}]; empty list removes it; RegApp registered implicitly)",
        "parameters": [
          {"name": "handle", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "app", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "requestBody": {"content": {"application/json": {"schema": {"type": "array", "items": {"type": "object", "properties": {"code": {"type": "integer"}, "value": {}}}}}}},
        "responses": {"200": {"description": "Written"}, "400": {"description": "Unsupported code"}}
      },
      "delete": {
        "summary": "Remove one application's extended data",
        "parameters": [
          {"name": "handle", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "app", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Removed"}}
      }
    },
    "/api/v1/blocks": {
      "post": {
        "summary": "Define a block from entities (BLOCK semantics: sources become the definition, one Insert placed at insert_at or base; replace:true drops a same-named definition first)",
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "required": ["name", "base", "handles"], "properties": {
          "name": {"type": "string"}, "base": {"type": "array", "items": {"type": "number"}},
          "handles": {"type": "array", "items": {"type": "string"}},
          "insert_at": {"type": "array", "items": {"type": "number"}},
          "replace": {"type": "boolean"}
        }}}}},
        "responses": {"201": {"description": "Definition + insert handle"}, "400": {"description": "Invalid name, duplicate or empty selection"}}
      }
    },
    "/api/v1/blocks/{name}": {
      "delete": {
        "summary": "Delete a block definition with its children, markers and every Insert referencing it",
        "parameters": [{"name": "name", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Erased count"}, "404": {"description": "Unknown block"}}
      }
    },
    "/api/v1/file-identity": {
      "post": {
        "summary": "Stable per-document GUID (the drawing's SPMDOCUNIQUE value); idempotent get-or-create, renew:true mints a fresh one",
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "properties": {"renew": {"type": "boolean"}}}}}},
        "responses": {"200": {"description": "The identity GUID"}}
      }
    },
    "/api/v1/groups": {
      "post": {
        "summary": "Create a named group over existing entities (stored in the group dictionary)",
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "required": ["name", "handles"], "properties": {
          "name": {"type": "string"}, "handles": {"type": "array", "items": {"type": "string"}}
        }}}}},
        "responses": {"201": {"description": "Group name + handle"}, "404": {"description": "Unknown handle"}}
      }
    },
    "/api/v1/selection-sets": {
      "post": {
        "summary": "Save a named handle set for this session (session-scoped by design)",
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "required": ["name", "handles"], "properties": {
          "name": {"type": "string"}, "handles": {"type": "array", "items": {"type": "string"}}
        }}}}},
        "responses": {"201": {"description": "Stored set"}}
      }
    },
    "/api/v1/selection-sets/{name}": {
      "get": {
        "summary": "Recall a named selection set (?select=true also makes it the current selection)",
        "parameters": [
          {"name": "name", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "select", "in": "query", "schema": {"type": "boolean"}}
        ],
        "responses": {"200": {"description": "Handles (+ selected count)"}, "404": {"description": "Unknown set"}}
      }
    },
    "/api/v1/plot": {
      "post": {
        "summary": "Render to PDF (layout Model|name|all, area, paper, fit/scale, plot_style; per_page:true with layout all writes one PDF per layout and returns result.files)",
        "responses": {"200": {"description": "Pages written"}, "400": {"description": "Plot failed"}}
      }
    },
    "/api/v1/wblock": {
      "post": {
        "summary": "Export entities (handles) or a block definition to a new DWG/DXF; template:<file> bases the new database on that file's tables/styles, normalize:true shifts the export so its minimum lands on the origin",
        "responses": {"200": {"description": "File written"}, "400": {"description": "Export failed"}}
      }
    },
    "/api/v1/images": {
      "post": {
        "summary": "Attach a picture (embedded OLE2FRAME default; linked:true for path-linked)",
        "responses": {"201": {"description": "Image handle"}, "400": {"description": "Attach failed"}}
      }
    },
    "/api/v1/commands": {
      "post": {
        "summary": "Run one editor command line (e.g. \"LINE 0,0 10,10\")",
        "responses": {"200": {"description": "Command status"}, "400": {"description": "Command failed"}}
      }
    },
    "/api/v1/undo": {"post": {"summary": "Undo one step in the active document, or the one named by {document_id}", "responses": {"200": {"description": "Undone"}}}},
    "/api/v1/redo": {"post": {"summary": "Redo one step in the active document, or the one named by {document_id}", "responses": {"200": {"description": "Redone"}}}},
    "/api/v1/save": {"post": {"summary": "Save the active document, or the one named by {document_id} ({path} optional once opened); a *.dwt path writes DWG bytes through a scratch file renamed into place", "responses": {"200": {"description": "Saved"}, "400": {"description": "Save failed"}}}},
    "/api/v1/layers": {"get": {"summary": "Layer table", "responses": {"200": {"description": "Layers"}}}},
    "/api/v1/header": {"get": {"summary": "Drawing header summary", "responses": {"200": {"description": "Header"}}}},
    "/api/v1/records": {"get": {"summary": "Database records (collection, type, offset, limit)", "responses": {"200": {"description": "Records"}, "400": {"description": "Invalid query"}}}},
    "/api/v1/openapi": {"get": {"summary": "This document", "responses": {"200": {"description": "OpenAPI JSON"}}}},
    "/api/v1/entities_set": {
      "post": {
        "summary": "Atomically apply one flat common-property patch to unique entity handles in one undo step",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EntitiesSetRequest"}}}},
        "responses": {"200": {"description": "{requested,written,unchanged}; no-op writes create no history"}, "400": {"description": "Unknown field, invalid value, duplicate handle, or locked/non-native target; nothing commits"}, "404": {"description": "Unknown handle; nothing commits"}}
      }
    },
    "/api/v1/dgn_import": {
      "post": {
        "summary": "Prompt-free DGN import through the same conversion and placement pipeline as -DGNIMPORT",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DgnImportRequest"}}}},
        "responses": {"200": {"description": "Resolved path, canonical model, and top-level converted entity count"}, "400": {"description": "Invalid DGN, model, units, mapping, codepage, or empty model"}}
      }
    },
    "/api/v1/{op}": {
      "post": {
        "summary": "Generic passthrough: any automation operation name with its JSON body (mutations are wrapped in the protocol envelope automatically)",
        "parameters": [{"name": "op", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Operation response"}}
      }
    }
  },
  "components": {
    "schemas": {
      "ExternalReference": {
        "type": "object",
        "required": ["id", "name", "kind", "format", "reference_type", "status", "saved_path", "resolved_path", "parent_id", "nested", "size_bytes", "modified_unix_ms"],
        "properties": {
          "id": {"type": "string", "description": "Hexadecimal definition handle"},
          "name": {"type": "string"},
          "kind": {"type": "string", "enum": ["dwg_xref", "image", "underlay", "point_cloud"]},
          "format": {"type": "string", "nullable": true},
          "reference_type": {"type": "string", "enum": ["attach", "overlay"], "nullable": true},
          "status": {"type": "string", "enum": ["loaded", "unloaded", "not_found", "failed", "stale", "orphaned", "unreferenced"]},
          "saved_path": {"type": "string", "description": "Raw stored path"},
          "resolved_path": {"type": "string", "nullable": true},
          "parent_id": {"type": "string", "nullable": true},
          "nested": {"type": "boolean"},
          "size_bytes": {"type": "integer", "format": "int64", "nullable": true},
          "modified_unix_ms": {"type": "integer", "format": "int64", "nullable": true}
        }
      },
      "XrefIdRequest": {
        "type": "object",
        "required": ["id"],
        "properties": {"id": {"type": "string", "description": "Direct reference id from GET /api/v1/xrefs"}}
      },
      "XrefSetPathRequest": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string", "minLength": 1},
          "path_type": {"type": "string", "enum": ["full", "relative", "none"]}
        },
        "oneOf": [{"required": ["path"]}, {"required": ["path_type"]}]
      },
      "XrefSetTypeRequest": {
        "type": "object",
        "required": ["id", "reference_type"],
        "properties": {
          "id": {"type": "string"},
          "reference_type": {"type": "string", "enum": ["attach", "overlay"]}
        }
      },
      "EntitiesSetRequest": {
        "type": "object",
        "required": ["handles"],
        "properties": {
          "handles": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "layer": {"type": "string"},
          "color": {"description": "ByLayer/ByBlock, ACI 0..256, {Index:N}, {Rgb:{r,g,b}}, or {rgb:[r,g,b]}"},
          "linetype": {"type": "string"},
          "linetype_scale": {"type": "number", "exclusiveMinimum": 0},
          "invisible": {"type": "boolean"},
          "label": {"type": "string", "minLength": 1}
        },
        "anyOf": [{"required": ["layer"]}, {"required": ["color"]}, {"required": ["linetype"]}, {"required": ["linetype_scale"]}, {"required": ["invisible"]}]
      },
      "DgnImportRequest": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "units": {"type": "string", "enum": ["Master", "Sub", "master", "sub"]},
          "mapping": {"type": "string", "description": "Standard, optionally followed by ;codepage=N"},
          "codepage": {"type": "integer", "description": "Explicit numeric code page; overrides mapping suffix and stored settings"}
        }
      }
    },
    "securitySchemes": {
      "bearer": {"type": "http", "scheme": "bearer", "description": "OCS_API_TOKEN, or the token printed on stderr at startup."}
    }
  }
}
